# Copie para .env e preencha com os dados de Connect > Session pooler.
# Credenciais administrativas apenas para a configuracao inicial.
# Os servicos usam as roles separadas de escrita e leitura abaixo.
SUPABASE_DB_HOST=COLE_O_HOST_DO_SESSION_POOLER
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.COLE_O_PROJECT_REF
SUPABASE_DB_PASSWORD=""
SUPABASE_DB_SSLMODE=verify-full
# Obrigatorio: caminho do certificado CA baixado de Database Settings > SSL.
# O verificador sempre valida certificado e hostname, inclusive com require.
SUPABASE_DB_SSLROOTCERT=certs/supabase-ca.crt

# Preencher depois de criar as roles (docs/banco-de-dados.md).
# Mesmo host, porta, banco e certificado acima; senhas diferentes por role.
GAMBLR_MIGRATION_DB_USER=gamblr_migrator.COLE_O_PROJECT_REF
GAMBLR_MIGRATION_DB_PASSWORD=""
GAMBLR_WRITE_DB_USER=gamblr_writer.COLE_O_PROJECT_REF
GAMBLR_WRITE_DB_PASSWORD=""
GAMBLR_READ_DB_USER=gamblr_reader.COLE_O_PROJECT_REF
GAMBLR_READ_DB_PASSWORD=""

# Supabase Auth: Project URL e chave publishable de Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Servico Spring Boot: issuer e derivado de SUPABASE_URL/auth/v1.
# Override normalmente desnecessario; deixe vazio com a URL padrao do projeto.
GAMBLR_AUTH_ISSUER=
GAMBLR_WRITER_PORT=8080
GAMBLR_READER_PORT=5000
GAMBLR_BIND_ADDRESS=127.0.0.1
